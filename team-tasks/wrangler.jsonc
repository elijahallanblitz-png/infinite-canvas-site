{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-tasks",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // The app's files are packed into the Worker (scripts/bundle-static.mjs), so one upload deploys everything.
  "build": { "command": "node scripts/bundle-static.mjs", "watch_dir": "public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "team-tasks",
      "database_id": "c07f48f2-2d35-40dd-9f28-dee2a9d74e1c",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Every hour, in UTC. The code decides what the Pacific hour means (9 AM digest, quiet hours).
    "crons": ["0 * * * *"]
  },
  "observability": { "enabled": true }
}
