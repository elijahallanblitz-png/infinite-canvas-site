{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-tasks",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths run code. Everything else is served straight from the edge.
    "run_worker_first": ["/api/*", "/join/*", "/claude/*", "/webhooks/*", "/manifest.webmanifest", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "team-tasks",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Every hour, in UTC. The code decides what the Pacific hour means (9 AM digest, quiet hours).
    "crons": ["0 * * * *"]
  },
  "observability": { "enabled": true }
}
