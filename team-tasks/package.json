{
  "name": "team-tasks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --test-scheduled",
    "db:local": "wrangler d1 migrations apply team-tasks --local",
    "db:remote": "wrangler d1 migrations apply team-tasks --remote",
    "keys": "node scripts/generate-keys.mjs",
    "seed": "node scripts/seed.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
